# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_INITIAL_PASSWORD: Initial administrator passcode verified strictly on the server.
# Configure this in AI Studio Settings -> Secrets (or set on first run in /#/yoneticipaneli).
ADMIN_INITIAL_PASSWORD=

# INSTAGRAM_ACCESS_TOKEN: Optional Instagram Graph API token for @kirmizivemavitakim follower sync.
# If omitted, server uses public profile lookup and always preserves last valid follower count.
INSTAGRAM_ACCESS_TOKEN=
